#!/usr/bin/env bash

# === CONFIG ROOT ===
CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"

# === CATPPUCCIN MOCHA COLORS (Purple-focused) ===
CLR_BG=0x00000000          # Transparent bar background
CLR_COMP_BG=0xff1e1e2e     # Compartment background (base)
CLR_COMP_BORDER=0xffcba6f7 # Compartment border (mauve - purple!)
CLR_FG=0xffcdd6f4          # Foreground text (text)
CLR_MAUVE=0xffcba6f7       # Mauve - main purple accent
CLR_LAVENDER=0xffb4befe    # Lavender - lighter purple
CLR_PINK=0xfff5c2e7        # Pink - softer accent

# === PADDING CONSTANTS
BAR_PADDING=8              # Outer bar padding
ITEM_PADDING=6             # Default horizontal padding between items
ICON_PADDING=2             # Consistent icon inner padding
LABEL_PADDING=2            # Consistent label inner padding
COMP_PADDING=6             # Compartment outer padding

# === BAR ===
sketchybar --bar position=top height=34 blur_radius=0 color="$CLR_BG" padding_left="$BAR_PADDING" padding_right="$BAR_PADDING"

